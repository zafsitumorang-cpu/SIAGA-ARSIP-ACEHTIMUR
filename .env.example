# npm start reads environment variables, not this file automatically.
PORT=3000
DATA_DIR=./data
# Explicit demo mode preserves the public demo. Never use true for real archives.
DEMO_MODE=true
# Production requires DEMO_MODE=false, NODE_ENV=production, DATABASE_URL and HTTPS origin.
# NODE_ENV=production
# DATABASE_URL=postgres://siaga:REPLACE_PASSWORD@127.0.0.1:5432/siaga
# APP_ORIGIN=https://YOUR_DOMAIN
# COOKIE_SECURE=true
# HOST=127.0.0.1
# BACKUP_DIR=/var/lib/siaga/backups
# Use bootstrap variables only for the one-time database CLI, not the running service.
# BOOTSTRAP_ADMIN_USERNAME=YOUR_ADMIN_NAME
# BOOTSTRAP_ADMIN_PASSWORD=SET_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
